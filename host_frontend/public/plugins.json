{
  "plugins": [
    {
      "id": "before-first-card",
      "remote_url": "http://localhost:3002/remoteEntry.js",
      "remote_name": "plugin_frontend",
      "remote_component": "Widget",
      "injection_config": {
        "target_selector": "#first-card",
        "injection_position": "before"
      }
    },
    {
      "id": "replace-middle-card",
      "remote_url": "http://localhost:3002/remoteEntry.js",
      "remote_name": "plugin_frontend",
      "remote_component": "Widget", 
      "injection_config": {
        "target_selector": "#middle-card",
        "injection_position": "replace"
      }
    },
    {
      "id": "after-last-card",
      "remote_url": "http://localhost:3002/remoteEntry.js",
      "remote_name": "plugin_frontend",
      "remote_component": "Widget",
      "injection_config": {
        "target_selector": "#last-card",
        "injection_position": "after"
      }
    },
    {
      "id": "bidirectional-main",
      "remote_url": "http://localhost:3002/remoteEntry.js",
      "remote_name": "plugin_frontend",
      "remote_component": "HostCardWidget", 
